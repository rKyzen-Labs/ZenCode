{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zencode",
  "version": "0.1.0",
  "identifier": "com.zencode.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zencode",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false,
    "externalBin": ["binaries/opencode"]
  }
}
